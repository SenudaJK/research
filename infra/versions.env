# Phase 1 (Sense) version pins — source of truth for reproducible deployments.
# Referenced by all infra scripts. Update docs/architecture.md when changing.

# Cluster
export KIND_VERSION="v0.27.0"
export KUBERNETES_VERSION="1.31.4"
export MINIKUBE_VERSION="v1.35.0"
export CLUSTER_NAME="self-healing-research"

# Workload — Google Online Boutique
export BOUTIQUE_VERSION="v0.10.6"
export BOUTIQUE_REPO="https://github.com/GoogleCloudPlatform/microservices-demo"
export BOUTIQUE_NAMESPACE="boutique"

# Observability — Helm chart versions (pinned 2026-08)
export HELM_KUBE_PROMETHEUS_STACK_CHART_VERSION="88.3.0"
export HELM_LOKI_CHART_VERSION="6.30.1"
export HELM_PROMTAIL_CHART_VERSION="6.17.0"
export HELM_JAEGER_CHART_VERSION="3.4.1"
export HELM_OTEL_COLLECTOR_CHART_VERSION="0.127.2"

# Container image pins (used by OTEL collector config / Jaeger)
export OTEL_COLLECTOR_IMAGE="otel/opentelemetry-collector-contrib:0.127.0"
export JAEGER_IMAGE="jaegertracing/all-in-one:1.64.0"
export LOKI_IMAGE_TAG="3.5.1"

# Namespaces
export OBSERVABILITY_NAMESPACE="observability"
export CHAOS_NAMESPACE="chaos-mesh"

# Baseline collection
export BASELINE_DURATION_SECONDS="${BASELINE_DURATION_SECONDS:-1800}"   # 30 minutes; override for smoke
export BASELINE_SAMPLE_INTERVAL_SECONDS="${BASELINE_SAMPLE_INTERVAL_SECONDS:-60}"
export BASELINE_OUTPUT_DIR="${BASELINE_OUTPUT_DIR:-evaluation/runs/baseline}"
